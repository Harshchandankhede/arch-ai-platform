# Frontend environment. Copy to .env and adjust as needed.
#
# Only variables prefixed VITE_ are exposed to the browser bundle, so never put a secret
# here. The Gemini key and the database URI belong in backend/.env, not this file.

# Base URL for the backend API.
#
# Leave it unset (or "/api") for normal use: the request then goes to the same origin as
# the page, and Vite proxies it to the backend in both `npm run dev` and `npm run preview`.
# Set it only when the API is genuinely on a different origin, e.g. in a deployment where
# the frontend and the API are separate services.
# VITE_API_BASE_URL=https://api.example.com/api

# How long the browser waits for an API response, in milliseconds.
#
# Generous by default because the slowest endpoint is not ours: the Gemini advisor proxies a
# language-model call that can legitimately take a minute under load.
# VITE_API_TIMEOUT_MS=120000

# Where Vite proxies /api while developing. Ignored when VITE_API_BASE_URL is set.
# Used by the end-to-end suite to point at its own backend instance.
# API_PROXY_TARGET=http://localhost:5000