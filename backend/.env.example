# ---- Server ----
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# ---- Frontend ----
# Origin of the React frontend, used as the default CORS allow-list entry.
CLIENT_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins.
# Leave unset to allow the localhost dev ports automatically.
# CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Set to false to silence per-request HTTP logging.
LOG_REQUESTS=true

# ---- Database ----
# NEVER put a real password in this file. This file is committed to git.
# The real credential belongs only in .env, which is git-ignored.
#
# This project uses MongoDB Atlas (the active database).
# Copy the full connection string from:
#   Atlas -> your cluster -> Connect -> Drivers -> Node.js
# Then paste it into your .env, not here.
#
# Shape of the Atlas string (placeholders only):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/archai?retryWrites=true&w=majority&authSource=admin
#
# IMPORTANT — URL encoding:
# If a password contains any of  @  :  /  ?  #  [  ]  %
# it must be percent-encoded, otherwise the driver misreads the string and
# authentication fails with "bad auth". Copying the string from Atlas avoids
# this because Atlas encodes it for you. Using a letters-and-digits-only
# password is the simplest way to avoid the problem entirely.
#
# To fall back to a local MongoDB instead, replace the value above with:
# MONGO_URI=mongodb://127.0.0.1:27017

# Database name applied to the connection. The backend reads models from it.
DB_NAME=archai

# How long Mongoose waits for a reachable server before giving up.
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# Optional DNS override for Atlas SRV lookups.
# Some campus/office DNS servers block _mongodb._tcp SRV records, which makes
# node fail with "querySrv ECONNREFUSED" even though browsers and mongosh
# connect fine. Setting this routes Atlas lookups through public resolvers.
# Leave unset on a normal network.
# MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8

# ---- Auth ----
# Secret used to sign and verify JWTs. Generate a strong random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Keep it out of git. If it changes, existing sessions are invalidated.
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ---- Planned for a later phase (not used yet) ----
# GEMINI_API_KEY=
