# ---- Server ----
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# ---- Frontend ----
# Origin of the React frontend, used as the default CORS allow-list entry.
CLIENT_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins.
# Leave unset to allow the localhost dev ports automatically.
# CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Set to false to silence per-request HTTP logging.
LOG_REQUESTS=true

# ---- Database ----
# NEVER put a real password in this file. This file is committed to git.
# The real credential belongs only in .env, which is git-ignored.
#
# This project uses MongoDB Atlas (the active database).
# Copy the full connection string from:
#   Atlas -> your cluster -> Connect -> Drivers -> Node.js
# Then paste it into your .env, not here.
#
# Shape of the Atlas string (placeholders only):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/archai?retryWrites=true&w=majority&authSource=admin
#
# IMPORTANT — URL encoding:
# If a password contains any of  @  :  /  ?  #  [  ]  %
# it must be percent-encoded, otherwise the driver misreads the string and
# authentication fails with "bad auth". Copying the string from Atlas avoids
# this because Atlas encodes it for you. Using a letters-and-digits-only
# password is the simplest way to avoid the problem entirely.
#
# To fall back to a local MongoDB instead, replace the value above with:
# MONGO_URI=mongodb://127.0.0.1:27017

# Database name applied to the connection. The backend reads models from it.
DB_NAME=archai

# How long Mongoose waits for a reachable server before giving up.
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# Optional DNS override for Atlas SRV lookups.
# Some campus/office DNS servers block _mongodb._tcp SRV records, which makes
# node fail with "querySrv ECONNREFUSED" even though browsers and mongosh
# connect fine. Setting this routes Atlas lookups through public resolvers.
# Leave unset on a normal network.
# MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8

# ---- Auth ----
# Secret used to sign and verify JWTs. Generate a strong random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Keep it out of git. If it changes, existing sessions are invalidated.
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ---- Gemini advisor (optional) ----
# The Recommendations page compares a deterministic rule-based advisor against a
# Gemini-generated one. Without a key the page still works: it shows the rules
# only and reports the Gemini arm as "not configured".
#
# Get a key from Google AI Studio and paste it into your .env, NOT here.
# This route is authenticated and rate limited, because it spends paid quota.
# Keep it server-side. A VITE_-prefixed variable is inlined into the public
# browser bundle and would leak the key to every visitor.
GEMINI_API_KEY=

# Pinned so published results stay reproducible. Changing it changes the
# advisor's output, so record whichever value produced a paper's figures.
#
# Choose this deliberately, not casually. The free tier allows only 20
# generateContent requests per MODEL per day, so each model you switch to has
# its own independent daily allowance. Measured from a free-tier key:
#   gemini-2.5-flash      rejected outright, closed to new users
#   gemini-3.8-flash      answers 503 "high demand" most of the time
#   gemini-3.7-flash      answers 503 "high demand" most of the time
#   gemini-flash-latest   works, but it is an ALIAS that currently resolves to
#                         3.8-flash, so it shares 3.8's daily quota
#   gemini-3.6-flash      returns structured JSON in ~3s  <- default
#   gemini-3.5-flash      also available
# All of the 3.x models support the responseSchema / responseMimeType output
# this advisor relies on.
GEMINI_MODEL=gemini-3.6-flash

# Budget for the whole call, retries included. A reasoning model on a cold
# start can take 10-60s, and the free tier intermittently answers 503, so a
# 20s ceiling reported a working advisor as broken.
GEMINI_TIMEOUT_MS=90000

# Transient 429/500/503/504 answers are retried with jittered exponential
# backoff up to this many attempts before the failure is surfaced.
GEMINI_MAX_ATTEMPTS=4

# Per-user quota guard, so a runaway client cannot drain the key's free tier.
ADVISOR_MAX_PER_WINDOW=10
ADVISOR_WINDOW_MS=60000
